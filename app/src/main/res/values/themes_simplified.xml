<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Simplified UI Theme for Elderly Users -->
    <style name="Theme.DawaLo.Simplified" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Large text sizes -->
        <item name="android:textSize">32sp</item>
        <item name="textAppearanceButton">@style/TextAppearance.Simplified.Button</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Simplified.Body</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Simplified.Headline</item>
        
        <!-- High contrast -->
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@color/white</item>
    </style>
    
    <style name="TextAppearance.Simplified.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.Simplified.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">24sp</item>
    </style>
    
    <style name="TextAppearance.Simplified.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <!-- Large buttons -->
    <style name="Widget.Simplified.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">80dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:padding">24dp</item>
    </style>
</resources>
